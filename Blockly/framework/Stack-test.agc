# Unit tests for the Stack functions.

# TEST: PUSH/POP

	CA	NUM1		# Push 1,2,3
	TCR	PUSH
	CA	NUM2
	TCR	PUSH
	CA	NUM3
	TCR	PUSH

	CA	NUM3		# Pop 3,2,1
	TCR	PUSH
	TCR	TS-EQUAL
	CA	NUM2
	TCR	PUSH
	TCR	TS-EQUAL
	CA	NUM1
	TCR	PUSH
	TCR	TS-EQUAL

# TEST: PEEK

	CA	NUM4		# Push 4,5
	TCR	PUSH
	CA	NUM5
	TCR	PUSH

	TCR	PEEK		# Peek 5
	TCR	PUSH
	CA	NUM5
	TCR	PUSH
	TCR	TS-EQUAL
	CA	NUM5		# Pop 5
	TCR	PUSH
	TCR	TS-EQUAL

	TCR	PEEK		# Peek 4
	TCR	PUSH
	CA	NUM4
	TCR	PUSH
	TCR	TS-EQUAL
	CA	NUM4		# Pop 4
	TCR	PUSH
	TCR	TS-EQUAL
