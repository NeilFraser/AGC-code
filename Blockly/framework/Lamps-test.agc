# Unit tests for the Lamp functions.

# TEST: LAMP

	CA	NUM0		# UPLINK ATCY - off
	TCR	PUSH
	CA	NUM4		# 100b = 4
	COM
	TCR	PUSH
	TCR	LAMP

	CA	NUM0		# NO ATT - off
	TCR	PUSH
	CA	NUM8		# 1000b = 8
	TCR	PUSH
	TCR	LAMP

#	CA	NUM0		# STBY - off
#	TCR	PUSH
#	CA	NUM256		# 1000 0000b = 256
#	COM
#	TCR	PUSH
#	TCR	LAMP

	CA	NUM0		# KEY REL - off
	TCR	PUSH
	CA	NUM16		# 1 0000b = 16
	COM
	TCR	PUSH
	TCR	LAMP

	CA	NUM0		# OPP ERR - off
	TCR	PUSH
	CA	NUM64		# 10 0000b = 64
	COM
	TCR	PUSH
	TCR	LAMP

	CA	NUM1		# TEMP - on
	TCR	PUSH
	CA	NUM8		# 1000b = 8
	COM
	TCR	PUSH
	TCR	LAMP

	CA	NUM1		# GIMBLE LOCK - on
	TCR	PUSH
	CA	NUM32		# 1 0000b = 32
	TCR	PUSH
	TCR	LAMP

	CA	NUM1		# PROG - on
	TCR	PUSH
	CA	NUM256		# 1 0000 0000b = 256
	TCR	PUSH
	TCR	LAMP

#	CA	NUM1		# RESTART - on
#	TCR	PUSH
#	CA	NUM128		# 100 0000b = 128
#	COM
#	TCR	PUSH
#	TCR	LAMP

	CA	NUM1		# TRACKER - on
	TCR	PUSH
	CA	NUM128		# 100 0000b = 128
	TCR	PUSH
	TCR	LAMP

	CA	NUM1		# ALT - on
	TCR	PUSH
	CA	NUM16		# 1 0000b = 16
	TCR	PUSH
	TCR	LAMP

	CA	NUM1		# VEL - on
	TCR	PUSH
	CA	NUM4		# 1000b = 4
	TCR	PUSH
	TCR	LAMP

	CA	NUM1		# COMP ACTY - on
	TCR	PUSH
	CA	NUM2		# 10b = 2
	COM
	TCR	PUSH
	TCR	LAMP

	TCF	TSLM-END


NUM32		DEC	32
NUM64		DEC	64
NUM256		DEC	256

TSLM-END NOOP
