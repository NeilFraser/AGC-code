
# https://neil.fraser.name/software/blockly-agc/editor/#q2iea2

PN		EXTEND
		QXCH	PN-QPOP

		TCR	POP
		TS	PN-ROW
		TCR	POP
		TS	PN-NUM

		CA	NUM0
		TS	PN-HAS
		TS	PN-I

		# Extract digit x0'000
PN-LP0	CA	PN-NUM
		TCR	PUSH
		CA	NUM10000
		TCR	PUSH
		TCR	MA-SU
		TCR	BL-GTE
		EXTEND
		BZF	PN-LP0-X
		CA	NUM10000
		COM
		ADS	PN-NUM
		CA	NUM1
		ADS	PN-I
		TC	PN-LP0

PN-LP0-X	CA	PN-I
		EXTEND
		BZF	PN-IF0-E
		CA	PN-I
		TCR	PUSH
		CA	NUM0
		TCR	PUSH
		CA	PN-ROW
		TCR	PUSH
		TCR	PRNTDIG
		CA	NUM1
		TS	PN-HAS
		TCF	PN-IF0-X

PN-IF0-E	CA	NUM10
		TCR	PUSH
		CA	NUM0
		TCR	PUSH
		CA	PN-ROW
		TCR	PUSH
		TCR	PRNTDIG

PN-IF0-X	CA	NUM0
		TS	PN-I

		# Extract digit x'000
PN-LP1	CA	PN-NUM
		TCR	PUSH
		CA	NUM1000
		TCR	PUSH
		TCR	MA-SU
		TCR	BL-GTE
		EXTEND
		BZF	PN-LP1-X
		CA	NUM1000
		COM
		ADS	PN-NUM
		CA	NUM1
		ADS	PN-I
		TC	PN-LP1

PN-LP1-X	CA	PN-I
		TCR	PUSH
		CA	PN-HAS
		TCR	PUSH
		TCR	BL-OR
		EXTEND
		BZF	PN-IF1-E
		CA	PN-I
		TCR	PUSH
		CA	NUM1
		TCR	PUSH
		CA	PN-ROW
		TCR	PUSH
		TCR	PRNTDIG
		CA	NUM1
		TS	PN-HAS
		TCF	PN-IF1-X

PN-IF1-E	CA	NUM10
		TCR	PUSH
		CA	NUM1
		TCR	PUSH
		CA	PN-ROW
		TCR	PUSH
		TCR	PRNTDIG

PN-IF1-X	CA	NUM0
		TS	PN-I

		# Extract digit x00
PN-LP2	CA	PN-NUM
		TCR	PUSH
		CA	NUM100
		TCR	PUSH
		TCR	MA-SU
		TCR	BL-GTE
		EXTEND
		BZF	PN-LP2-X
		CA	NUM100
		COM
		ADS	PN-NUM
		CA	NUM1
		ADS	PN-I
		TC	PN-LP2

PN-LP2-X	CA	PN-I
		TCR	PUSH
		CA	PN-HAS
		TCR	PUSH
		TCR	BL-OR
		EXTEND
		BZF	PN-IF2-E
		CA	PN-I
		TCR	PUSH
		CA	NUM2
		TCR	PUSH
		CA	PN-ROW
		TCR	PUSH
		TCR	PRNTDIG
		CA	NUM1
		TS	PN-HAS
		TCF	PN-IF2-X

PN-IF2-E	CA	NUM10
		TCR	PUSH
		CA	NUM2
		TCR	PUSH
		CA	PN-ROW
		TCR	PUSH
		TCR	PRNTDIG

		# Extract digit x0
PN-IF2-X	CA	NUM0
		TS	PN-I

PN-LP3	CA	PN-NUM
		TCR	PUSH
		CA	NUM10
		TCR	PUSH
		TCR	MA-SU
		TCR	BL-GTE
		EXTEND
		BZF	PN-LP3-X
		CA	NUM10
		COM
		ADS	PN-NUM
		CA	NUM1
		ADS	PN-I
		TC	PN-LP3

PN-LP3-X	CA	NUM10
		TCR	PUSH
		CA	PN-I
		TCR	PUSH
		CA	PN-I
		TCR	PUSH
		CA	PN-HAS
		TCR	PUSH
		TCR	BL-OR
		TCR	PUSH
		TCR	BL-COND
		TCR	PUSH
		CA	NUM3
		TCR	PUSH
		CA	PN-ROW
		TCR	PUSH
		TCR	PRNTDIG

		# Extract last digit
		CA	PN-NUM
		TCR	PUSH
		CA	NUM4
		TCR	PUSH
		CA	PN-ROW
		TCR	PUSH
		TCR	PRNTDIG

		EXTEND
		QXCH	PN-QPOP
		RETURN


PN-QPOP	=	110
PN-ROW	=	111
PN-NUM	=	112
PN-HAS	=	113
PN-I	=	114

# 100 & 10'000 also used in Random-test!!
NUM100	DEC	100
NUM1000	DEC	1000
NUM10000	DEC	10000
