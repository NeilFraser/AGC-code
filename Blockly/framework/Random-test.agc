# Unit tests for the random number generator

# Initialize the random number generator with seed

		CA	NUM9601
		TCR	PUSH
		TCR	INITGEN


# TEST: with upper bound (exclusive) one, the generated number is always zero

		CA	NUM100
		TS	LOOPIDX
LOOP1	CA	NUM1
		TCR	PUSH
		TCR	GRNDNUM
		TCR	PUSH
		CA	NUM0
		TCR	PUSH
		TCR	TS-EQUAL
		EXTEND
		DIM	LOOPIDX
		CA	LOOPIDX
		EXTEND
		BZF	END1
		TCF	LOOP1
END1	NOOP



# TEST: random number is smaller than upper bound

		CA	NUM100
		TS	LOOPIDX
LOOP2	CA	NUM2
		TCR	PUSH
		TCR	GRNDNUM
		TCR	PUSH
		CA	NUM1
		TCR	PUSH
		TCR	MA-SU
		TCR	BL-LTE
		TCR	BL-NOT
		TCR	PUSH
		CA	NUM0
		TCR	PUSH
		TCR	TS-EQUAL
		EXTEND
		DIM	LOOPIDX
		CA	LOOPIDX
		EXTEND
		BZF	END2
		TCF	LOOP2
END2	NOOP



# TEST: for large upper bound, two sequential numbers are not (very unlikely) the same

		CA	NUM10000
		TS	PREVNUM
		CA	NUM100
		TS	LOOPIDX
LOOP3		CA	PREVNUM
		TCR	PUSH
		CA	NUM10000
		TCR	PUSH
		TCR	GRNDNUM
		TS	PREVNUM
		TCR	PUSH
		TCR	MA-SU
		TCR	BL-NOT
		TCR	PUSH
		CA	NUM0
		TCR	PUSH
		TCR	TS-EQUAL
		EXTEND
		DIM	LOOPIDX
		CA	LOOPIDX
		EXTEND
		BZF	END3
		TCF	LOOP3
END3		NOOP

		TCF	TSRD-END



NUM10000	DEC	10000
NUM9601		DEC	9601
PREVNUM	=	600
LOOPIDX	=	601


TSRD-END NOOP
